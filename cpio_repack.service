<service name="cpio_repack">
  <summary>Repack an obs_scm source tree as a versioned source tarball</summary>
  <description>
    Reads Name and Version from a spec file using rpmspec, honouring all RPM
    macros including %include chains. Locates the source tree extracted by
    obs_scm via the .obsinfo file, renames the top-level directory to
    &lt;name&gt;-&lt;version&gt;, and packs it as a conventionally named
    &lt;name&gt;-&lt;version&gt;.tar.&lt;compression&gt; tarball.

    All files referenced by %include directives in the spec (e.g. version.inc
    files) must already be present in the working directory. Use obs_scm +
    extract_file before this service to ensure they are available.

    Designed for use with mode="buildtime". No server-side installation or
    administrator privileges are required; add BuildRequires on the
    obs-service-cpio_repack package in your project.
  </description>
  <parameter name="spec">
    <description>
      Glob pattern matching the .spec file to query for Name and Version.
      Default: *.spec
    </description>
  </parameter>
  <parameter name="compression">
    <description>
      Output compression format for the produced tarball.
      Default: bz2
    </description>
    <allowedvalue>gz</allowedvalue>
    <allowedvalue>bz2</allowedvalue>
    <allowedvalue>xz</allowedvalue>
    <allowedvalue>zst</allowedvalue>
  </parameter>
</service>
